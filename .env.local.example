# Copy this file to .env.local and fill in your values.
# For Vercel deployments, run `vercel env pull .env.local` after linking a Neon database.

ANTHROPIC_API_KEY=sk-ant-...

# Neon / Vercel Postgres connection string
# Local: create a free Neon project at https://neon.tech and paste the connection string here
# Vercel: injected automatically when you link a Neon database in the Vercel dashboard
DATABASE_URL=postgres://...
# (Vercel also injects POSTGRES_URL -- either one works)

# ── Auth (email + one-time code, no password) ────────────────────────────────
# The one fixed admin email -- can only be changed by redeploying with a new
# value, which is intentional (prevents ever locking every admin out).
# Sign-in codes are sent via AgentMail (below), verified against the
# sessions/login_codes tables. The admin can invite additional "guest"
# users from the in-app /admin page; guests share the same data as the
# admin but can't reach /admin themselves.
ADMIN_EMAIL=you@example.com

# ── LEGACY: email/OCR receipt ingestion ──────────────────────────────────────
# Superseded by Plaid transactions (below). Off by default; set to "true" to
# re-enable. See src/legacy/.
# NEXT_PUBLIC_ENABLE_RECEIPT_OCR=true
# ENABLE_EMAIL_INGESTION=true

# AgentMail (inbound email ingestion) -- provisioned via `vercel integration add agentmail`
AGENTMAIL_API_KEY=am_us_...
# Secret for the /api/inbound-email webhook, from `client.webhooks.create(...)`.
# Verifies inbound requests actually came from AgentMail (Svix signature).
AGENTMAIL_WEBHOOK_SECRET=whsec_...

# ── Plaid (bank transaction sync) ────────────────────────────────────────────
# All server-only. Never prefix these with NEXT_PUBLIC_. Full setup steps:
# docs/plaid-setup.md

# Dashboard → Developers → Keys → "client_id". Same value in every environment.
PLAID_CLIENT_ID=...
# Dashboard → Developers → Keys → the secret matching PLAID_ENV (the Sandbox
# and Production secrets are different values).
PLAID_SECRET=...
# "sandbox" (default, fake test data only) or "production" (real banks,
# requires Plaid's Production access approval and the Production secret).
PLAID_ENV=sandbox
# Optional. Public URL Plaid POSTs webhooks to (new transactions available,
# item needs re-login). Must be a stable, unprotected URL, e.g.
# https://huskytrack.vercel.app/api/plaid/webhook. Leave unset locally
# (Plaid can't reach localhost); use the "Sync now" button instead.
PLAID_WEBHOOK_URL=
# Optional in Sandbox, required in Production for OAuth banks (Chase, BofA,
# Wells Fargo, Capital One, ...). Must be listed under Dashboard → Developers →
# API → Allowed redirect URIs, e.g. https://huskytrack.vercel.app/oauth-return.
# Must be https (http://localhost is allowed in Sandbox only).
PLAID_REDIRECT_URI=
# 32-byte key (base64) used to encrypt stored Plaid access tokens and
# transaction fields at rest. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Changing it makes all existing stored Plaid data unreadable, so keep it
# identical everywhere that shares the same database.
PLAID_ENCRYPTION_KEY=...
