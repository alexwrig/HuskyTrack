# Copy this file to .env.local and fill in your values.
# For Vercel deployments, run `vercel env pull .env.local` after linking a Neon database.

ANTHROPIC_API_KEY=sk-ant-...

# Neon / Vercel Postgres connection string
# Local: create a free Neon project at https://neon.tech and paste the connection string here
# Vercel: injected automatically when you link a Neon database in the Vercel dashboard
DATABASE_URL=postgres://...
# (Vercel also injects POSTGRES_URL -- either one works)

# Optional: set a password to protect the site. Leave unset for open access.
SITE_PASSWORD=your-password-here

# ── LEGACY: email/OCR receipt ingestion ──────────────────────────────────────
# Superseded by Plaid transactions (below). Off by default; set to "true" to
# re-enable. See src/legacy/.
# NEXT_PUBLIC_ENABLE_RECEIPT_OCR=true
# ENABLE_EMAIL_INGESTION=true

# AgentMail (inbound email ingestion) -- provisioned via `vercel integration add agentmail`
AGENTMAIL_API_KEY=am_us_...
# Secret for the /api/inbound-email webhook, from `client.webhooks.create(...)`.
# Verifies inbound requests actually came from AgentMail (Svix signature).
AGENTMAIL_WEBHOOK_SECRET=whsec_...

# ── Plaid (bank transaction sync) ────────────────────────────────────────────
# Get Sandbox credentials at https://dashboard.plaid.com
PLAID_CLIENT_ID=...
PLAID_SECRET=...
# 32-byte key (base64) used to encrypt stored Plaid access tokens at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PLAID_ENCRYPTION_KEY=...
